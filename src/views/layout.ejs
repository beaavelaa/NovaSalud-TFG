<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="UTF-8" />

    <title>
        <%= typeof titulo !== 'undefined'
            ? titulo
            : "NovaSalud - Plataforma Médica" %>
    </title>

    
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap"
        rel="stylesheet"
    >

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>

        body {
            font-family: 'Inter', sans-serif;
            background-color: #f1f5f9;
        }

        .sidebar {
            width: 240px;
            height: 100vh;
            position: fixed;
            background: #1e293b;
            color: white;
            padding: 20px;
        }

        .sidebar h4 {
            font-weight: 700;
            margin-bottom: 30px;
        }

        .sidebar a {
            display: block;
            color: #cbd5e1;
            text-decoration: none;
            padding: 10px;
            border-radius: 8px;
            margin-bottom: 8px;
        }

        .sidebar a:hover {
            background: #334155;
            color: white;
        }

        .main-content {
            margin-left: 260px;
            padding: 30px;
        }

        .topbar {
            background: white;
            padding: 15px 30px;
            border-bottom: 1px solid #e2e8f0;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .card {
            border: none;
            border-radius: 12px;
        }

        .badge {
            padding: 6px 10px;
            font-weight: 500;
        }

    </style>

</head>

<body>

<% if (session.usuario) { %>

    
    <div class="sidebar">

        <h4>🩺 NovaSalud</h4>

        
        <% if (session.usuario.rol === "admin") { %>

            <a href="/admin">📊 Dashboard</a>

            <a href="/admin/usuarios">
                👤 Usuarios
            </a>

            <a href="/pacientes">
                👥 Pacientes
            </a>

        <% } %>


        <% if (session.usuario.rol === "medico") { %>

            <a href="/">🏠 Dashboard</a>

            <a href="/pacientes">
                👥 Pacientes
            </a>

            <a href="/citas">
                📅 Citas
            </a>

        <% } %>


        <% if (session.usuario.rol === "paciente") { %>

            <a href="/paciente">
                📅 Mis citas
            </a>

            <a href="/paciente/historial">
                📋 Historial
            </a>

        <% } %>

    </div>


    
    <div class="main-content">

        
        <div class="topbar">

            <div>

                <strong>

                    <% if (session.usuario.rol === "admin") { %>
                        Panel Administrador
                    <% } %>

                    <% if (session.usuario.rol === "medico") { %>
                        Panel Médico
                    <% } %>

                    <% if (session.usuario.rol === "paciente") { %>
                        Portal del Paciente
                    <% } %>

                </strong>

            </div>

            <div class="d-flex align-items-center gap-3">

                <span>
                    👤 <%= session.usuario.nombre %>

                    <small class="text-muted">
                        (<%= session.usuario.rol %>)
                    </small>
                </span>

                <a
                    href="/auth/logout"
                    class="btn btn-sm btn-outline-danger"
                >
                    🚪 Salir
                </a>

            </div>

        </div>


        
        <div class="mt-4">
            <%- body %>
        </div>

    </div>

<% } else { %>

    <div>
        <%- body %>
    </div>

<% } %>

</body>
</html>