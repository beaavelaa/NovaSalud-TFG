<h2 class="mb-4 fw-bold">Dashboard del Administrador</h2>

<div class="row g-3 mb-4">

  <div class="col-md-3">
    <div class="card p-3 bg-primary text-white shadow-sm">
      <h6>Pacientes</h6>
      <h2><%= pacientes %></h2>
    </div>
  </div>

  <div class="col-md-3">
    <div class="card p-3 bg-success text-white shadow-sm">
      <h6>Citas</h6>
      <h2><%= citas %></h2>
    </div>
  </div>

  <div class="col-md-3">
    <div class="card p-3 bg-warning text-dark shadow-sm">
      <h6>Médicos</h6>
      <h2><%= medicos %></h2>
    </div>
  </div>

  <div class="col-md-3">
    <div class="card p-3 bg-dark text-white shadow-sm">
      <h6>Usuarios activos</h6>
      <h2><%= usuariosActivos %></h2>
    </div>
  </div>

</div>


<div class="card p-4 mb-4 shadow-sm">
  <h5 class="mb-3">📈 Estadísticas de Citas</h5>
  <canvas id="graficaAdmin" height="100"></canvas>
</div>

<script>
  
  const meses = <%- JSON.stringify(meses || []) %>;
  const citasPorMes = <%- JSON.stringify(citasPorMes || []) %>;

  const ctx = document.getElementById("graficaAdmin");

  if (ctx) {
    new Chart(ctx, {
      type: "line",
      data: {
        labels: meses,
        datasets: [{
          label: "Citas",
          data: citasPorMes,
          borderColor: "#3b82f6",
          backgroundColor: "rgba(59,130,246,0.15)",
          borderWidth: 2,
          pointRadius: 4,
          tension: 0.4,
          fill: true
        }]
      },
      options: {
        responsive: true,
        plugins: {
          legend: { display: false }
        },
        scales: {
          y: {
            beginAtZero: true,
            ticks: {
              stepSize: 1
            }
          }
        }
      }
    });
  }
</script>

<div class="card p-4 shadow-sm">
  <h5 class="mb-3">📋 Actividad del Sistema</h5>

  <table class="table table-sm">
    <thead>
      <tr>
        <th>Usuario</th>
        <th>Rol</th>
        <th>Acción</th>
        <th>Detalle</th>
        <th>Fecha</th>
      </tr>
    </thead>

    <tbody>
      <% logs.forEach(l => { %>
        <tr>
          <td><%= l.usuario %></td>
          <td><%= l.rol %></td>
          <td><%= l.accion %></td>
          <td><%= l.detalle %></td>
          <td>
            <%= l.fecha && l.fecha.toDate 
                ? l.fecha.toDate().toLocaleString() 
                : "Sin fecha" %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>